# ---------------------------------------------------------------
# Notes never belong in this repository.
# They live in the notes folder chosen in Settings, Storage
# (Documents\MyNotes by default), which sits outside this project.
# The rules below are a safety net in case a notes folder is ever
# created inside the project folder.
# ---------------------------------------------------------------
/MyNotes/
/notes/
/vault/
/*/workspace.json
/*/settings.json
/*/pages/
/*/assets/
/*/.trash/

# OneNote export and migration output (these hold note content)
/.onenote-export/
/import-report*.json
*.one
*.onetoc2

# Voice mode's own speech engine (speech-engine/setup-speech.ps1)
/speech-engine/.venv-speech/
/speech-engine/speech-models/
__pycache__/

# Build output
node_modules/
/dist/
/dist-electron/
/release/
/build/icon.ico

# Tooling noise
.vscode/
.idea/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.tmp
*.tmp-*
credentials.txt
demo-shots/
